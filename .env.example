# Copie para .env e preencha. Nunca commite o .env.

# Banco
POSTGRES_USER=metabi
POSTGRES_PASSWORD=metabi_dev
POSTGRES_DB=metabi
POSTGRES_PORT=5432
DATABASE_URL=postgresql://metabi:metabi_dev@localhost:5432/metabi?schema=public

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
TZ=America/Sao_Paulo

# Autenticação
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MIN=30
LOGIN_MAX_ATTEMPTS=5

# E-mail (esqueci minha senha)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BI Meta Hospitalar <no-reply@metahospitalar.com.br>"

# Importação
UPLOAD_DIR=./storage/uploads
IMPORT_MAX_FILE_MB=10
