# Modelo do .env. Gere o seu com `pnpm setup:env` (cria senhas aleatórias).
# Nunca commite o .env. Valores "__GERADO__" são preenchidos pelo setup.

# Banco
POSTGRES_USER=metabi
POSTGRES_PASSWORD=__GERADO__
POSTGRES_DB=metabi
POSTGRES_PORT=5432
DATABASE_URL=postgresql://metabi:__POSTGRES_PASSWORD__@localhost:5432/metabi?schema=public
DATABASE_URL_TEST=postgresql://metabi:__POSTGRES_PASSWORD__@localhost:5432/metabi_test?schema=public

# API
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
TZ=America/Sao_Paulo

# Autenticação
JWT_ACCESS_SECRET=__GERADO__
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MIN=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
COOKIE_SECURE=false

# E-mail (dev: Mailpit em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BI Meta Hospitalar <no-reply@metahospitalar.com.br>"
APP_URL=http://localhost:3000

# Importação
UPLOAD_DIR=./storage/uploads
IMPORT_MAX_FILE_MB=10
