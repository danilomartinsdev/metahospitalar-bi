{
  "name": "meta-bi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BI Executivo — Meta Hospitalar",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @meta-bi/shared build && pnpm --parallel --filter @meta-bi/shared --filter api --filter web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @meta-bi/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @meta-bi/shared build && pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "setup:env": "node scripts/setup-env.mjs",
    "db:up": "docker compose up -d --wait postgres mailpit",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait postgres mailpit",
    "db:logs": "docker compose logs -f postgres",
    "secrets:check": "node scripts/check-secrets.mjs --all",
    "homolog:preparar": "node scripts/homologacao.mjs preparar",
    "homolog:subir": "node scripts/homologacao.mjs subir",
    "homolog:copiar-prod": "node scripts/homologacao.mjs copiar-prod",
    "homolog:status": "node scripts/homologacao.mjs status",
    "homolog:parar": "node scripts/homologacao.mjs parar",
    "hooks:test": "node --test .claude/hooks/*.test.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
